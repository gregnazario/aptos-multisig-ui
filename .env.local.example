# =============================================================================
# Aptos Multisig UI — example environment file
#
# Copy this to `.env.local` (Next.js loads it automatically) and adjust values:
#   cp .env.local.example .env.local
#
# Everything here has a working default for local development, so the app runs
# out of the box. Only NEXT_PUBLIC_* variables are exposed to the browser;
# all others stay server-side.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (SQLite via Drizzle / better-sqlite3)
# -----------------------------------------------------------------------------
# Path to the SQLite file. The "file:" prefix is stripped automatically.
# Defaults to "local.db" in the project root if unset.
DATABASE_URL=file:local.db

# -----------------------------------------------------------------------------
# Server / reverse proxy (production)
# -----------------------------------------------------------------------------
# Port the Next.js production server (`next start`) listens on. Defaults to 3000.
# Consumed by `make restart` (via pm2) and by the Caddy reverse proxy upstream.
# Note: `pnpm dev` always uses port 3123 regardless of this value.
PORT=3000

# Public domain served over HTTPS by Caddy (see Caddyfile). Leave empty for a
# single-machine HTTP-only setup; `make caddy` is skipped when unset.
# Caddy auto-provisions a Let's Encrypt certificate for this domain.
# DOMAIN=multisig.example.com

# -----------------------------------------------------------------------------
# Session signing (JWT)
# -----------------------------------------------------------------------------
# Secret used to sign wallet-auth session tokens (HS256).
# In development this falls back to "dev-secret" if unset.
# REQUIRED in production — the app throws on startup without it.
JWT_SECRET=dev-secret-change-in-production

# -----------------------------------------------------------------------------
# Admin addresses (optional)
# -----------------------------------------------------------------------------
# Comma-separated Aptos account addresses allowed to create proposals in
# addition to the multisig's own signers. Leave empty to restrict proposal
# creation to signers only.
# APTOS_ADMIN_ADDRESSES=0xabc...,0xdef...

# -----------------------------------------------------------------------------
# Gas Station (optional) — automated fee payer
# -----------------------------------------------------------------------------
# When enabled, a backend Ed25519 key sponsors gas for proposals that name the
# gas station's address as fee payer. Disabled by default.
GAS_STATION_ENABLED=false
# Ed25519 private key (hex, 0x-prefixed). Only used when GAS_STATION_ENABLED=true.
GAS_STATION_PRIVATE_KEY=
# Max gas units the fee payer will sponsor per transaction. Defaults to 10000.
GAS_STATION_MAX_GAS_PER_TX=10000
# Networks the gas station will sponsor on. Defaults to "devnet,testnet".
GAS_STATION_NETWORKS=devnet,testnet

# -----------------------------------------------------------------------------
# Split deployment (optional) — frontend and backend on separate hosts
# -----------------------------------------------------------------------------
# Leave all of these unset for the default single-machine setup.
#
# Frontend-only host: proxy all /api/* requests to a remote backend.
# BACKEND_URL=https://api.example.com
#
# Backend-only host: allow the frontend's origin via CORS headers.
# CORS_ORIGIN=https://app.example.com
#
# Alternative: point the browser directly at a remote API instead of using
# same-origin /api routes. Exposed to the browser (NEXT_PUBLIC_ prefix).
# Leave empty to use local /api routes.
# NEXT_PUBLIC_API_URL=
