{
  "name": "aptos-multisig-ui",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.7",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "next dev --port 3123",
    "build": "npm rebuild better-sqlite3 && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "lint:fix": "biome check --fix src/",
    "format": "biome format --write src/",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aptos-labs/ts-sdk": "7.5.0",
    "@aptos-labs/wallet-adapter-react": "8.3.3",
    "@base-ui/react": "1.9.0",
    "@libsql/client": "0.18.0",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "jose": "6.2.13",
    "lucide-react": "1.61.0",
    "next": "16.4.2",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "4.22.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "uuid": "14.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "0.31.11",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "esbuild": "0.28.2"
  }
}
